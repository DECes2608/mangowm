{
//-*- mode: jsonc -*-
    "layer": "bottom",
    "position": "bottom",
    "height": 20,
    "spacing": 4,
    "radius": 5,

    "modules-left": [
        "custom/arch",
        "ext/workspaces",
        "custom/sep",
        "mpris"
    ],
    "modules-center": [
        "clock",
  ],

    "modules-right": [
        "network",
        "custom/sep",
        "memory",
        "custom/sep",
        "wireplumber",
        "custom/sep",
        "battery",
        "custom/sep",
        "cpu",
        "custom/sep",
        "tray"
    ],

    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 9
        }
    },

    "custom/arch": {
        "format": " /deces",
        "tooltip": false
    },

    "custom/cpucat": {
        "exec": "~/.config/waybar/scripts/catloop.sh"
    },

    "ext/window": {
        "max-length": 40,
        "seperate-outputs": false
    },

    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "󰐊 {artist} - {title}",
        "max-length": 45,
        "tooltip": true,
        "player": "drift"
    },

    "wireplumber": {
        "format": "Vol: {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },

"network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Kablolu",
    "format-disconnected": "󰖪 Yok",
    "tooltip-format": "{ipaddr}/{cidr}",
    "on-click": "foot -e nmtui"
},

"memory": {
    "interval": 3,
    "format": "{used:0.2f}-GB",
    "tooltip-format": "{used:0.2f} / {total:0.2f} GiB"
},

    "tray": {
        "spacing": 10
    },

    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },

    "disk": {
        "interval": 1,
        "path": "/",
        "format": "Disk: {free}"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}% {icon} {time}",
        "format-plugged": "{capacity}% ",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}",
        "format-icons": ["", "", "", "", ""]
    },

"custom/sep": {
        "format": "|",
        "interval": "once"
    }
}
```
