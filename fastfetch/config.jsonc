{
  "logo": {
    "type": "sixel",
    "source": "/$HOME/.config/fastfetch/blc.png",
    "height": 14,
    "padding": {
      "top": 2,
      "left": 2
    }
  },

  "display": {
    "key": {
      "width": 15
    },
    "color": "#666666",
    "separator": "~>"
  },
  "modules": [
    "break",
{
      "type": "title",
      "format": "{6}",
      "color": {
        "user": "#a855f7"
      }
    },

    "separator",
    {
      "type": "os",
      "key": "OS       ",
      "keyColor": "#d4d4d4",
      "format": "Arch (Btw)"
    },
    {
      "type": "kernel",
      "key": "Kernel   ",
      "keyColor": "#d4d4d4",
      "format": "{1} {2}"
    },
    {
      "type": "users",
      "key": "User     ",
      "keyColor": "#d4d4d4",
      "format": "Deces"
    },
    "break",
    {
      "type": "uptime",
      "key": "Uptime   ",
      "keyColor": "#d4d4d4"
    },
    {
      "type": "board",
      "key": "Device   ",
      "keyColor": "#d4d4d4",
      "format": "14-inch Ideapad 5 | 2 in 1"
    },
    {
      "type": "bios",
      "key": "Bios     ",
      "keyColor": "#d4d4d4",
      "format": "{4}"
    },
    {
      "type": "cpu",
      "key": "CPU      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#d4d4d4",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "GPU      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#d4d4d4",
      "format": "{1} {2} {4}"
    },
    {
      "type": "memory",
      "key": "RAM      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#d4d4d4",
      "format": "{1} / {2} {3}"
    },
    "break",
    {
      "type": "Disk",
      "key": "Disk     ",
      "keyColor": "#d4d4d4",
      "format": "{1} / {2} {3} "
    }
  ]
}
